{
  "name": "@chatlychat/sdk-js",
  "version": "0.1.0",
  "description": "Browser SDK for the LiveChat platform — identify visitors, fire events, control the widget.",
  "license": "MIT",
  "homepage": "https://chatlychat.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatlychat/chatly-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/chatlychat/chatly-sdk-js/issues"
  },
  "keywords": [
    "livechat",
    "chat",
    "messaging",
    "support",
    "widget",
    "sdk"
  ],
  "author": "LiveChat Platform Engineering",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
